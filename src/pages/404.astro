---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found" noindex>
  <div class="container page-body" style="text-align:center;padding-top:5rem">
    <div class="eyebrow">404</div>
    <h1>We couldn't find that page</h1>
    <p class="lead">The site was rebuilt in 2026 and a few old links changed. Try one of these:</p>
    <p><a class="btn btn-primary" href={url('/')}>Home</a> <a class="btn btn-outline" href={url('/dues/')}>Pay dues</a> <a class="btn btn-outline" href={url('/documents/')}>Documents</a> <a class="btn btn-outline" href={url('/newsletters/')}>Newsletters</a></p>
  </div>
</Base>
