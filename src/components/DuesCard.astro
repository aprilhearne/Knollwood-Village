---
import { url } from '../lib/url';
import site from '../data/site.json';
---
<div class="card card-soft">
  <div class="eyebrow">{site.duesYear} annual dues</div>
  <div class="amount">${site.duesAmount}</div>
  <p class="small">${site.duesCivic} civic club dues + ${site.duesSecurity} security patrol contribution. Less than eighty cents a day for a neighborhood with its own patrol.</p>
  <a class="btn btn-primary" href={url('/dues/')}>Pay dues</a>
  <p class="small muted" style="margin:.75rem 0 0">Zelle (no fee): {site.emails.treasurer}</p>
</div>
<style>
  .amount { font-family: var(--font-serif); font-size: 2.6rem; font-weight: 700; color: var(--navy); line-height: 1; margin-bottom: .5rem; }
</style>
