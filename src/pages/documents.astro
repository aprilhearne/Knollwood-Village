---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../lib/url';
const groups = [
  { title: 'Civic Club', items: [
    ['/docs/club/KVCC-Bylaws-2004.pdf', 'Knollwood Village Civic Club By-Laws', '2004'],
    ['/docs/club/Summary-of-Constitutional-Amendments-2019.pdf', 'Summary of Constitutional Amendments', '2019'],
    ['/docs/club/Resident-Meeting-Minutes-2020-09-03.pdf', 'Annual Resident Meeting minutes', 'Sep 3, 2020'],
    ['/docs/club/Resident-Meeting-Minutes-2019-09-25.pdf', 'Annual Resident Meeting minutes', 'Sep 25, 2019'],
  ]},
  { title: 'Deed restrictions', items: [
    ['/docs/deeds/Deed-Restrictions-Section-1.pdf', 'Section 1'], ['/docs/deeds/Deed-Restrictions-Section-2.pdf', 'Section 2'], ['/docs/deeds/Deed-Restrictions-Section-3.pdf', 'Section 3'], ['/docs/deeds/Deed-Restrictions-Section-4.pdf', 'Section 4'], ['/docs/deeds/Deed-Restrictions-Section-5.pdf', 'Section 5'],
    ['/docs/deeds/Deed-Restrictions-Section-6.pdf', 'Section 6'], ['/docs/deeds/Deed-Restrictions-Section-7.pdf', 'Section 7'], ['/docs/deeds/Deed-Restrictions-Section-8.pdf', 'Section 8 (amended 2020)'], ['/docs/deeds/Deed-Restrictions-Section-9.pdf', 'Section 9'], ['/docs/deeds/Deed-Restrictions-Section-10.pdf', 'Section 10'],
    ['/docs/deeds/Deed-Restrictions-Braes-Terrace-II.pdf', 'Braes Terrace II'], ['/docs/deeds/Front-Fence-Guideline-2022.pdf', 'Front Fence Guideline', '2022'], ['/docs/deeds/Section-8-Amendment-Sep-2020.pdf', 'Section 8 amendment', 'Sep 2020'],
  ]},
  { title: 'Building & ACC', items: [
    ['/docs/acc/Plan-Approval-Submission-Form.pdf', 'Plan Approval Submission Form'], ['/docs/acc/Plan-Approval-Submission-Form.docx', 'Plan Approval Submission Form (Word)'],
    ['/docs/acc/Construction-Site-Guidelines-and-Pledge.pdf', 'Construction Site Guidelines & Pledge of Maintenance'],
    ['/docs/acc/Guideline-for-Multi-Story-Residences-2020.pdf', 'Guideline for Multi-Story Residences (except Section 8 and Braes Terrace II)', 'Sep 2020'],
    ['/docs/acc/Building-Guidelines-Section-8.pdf', 'Building guidelines for Section 8', '2020'],
    ['/docs/acc/Residential-Security-Measures-Guidelines-2022.pdf', 'Guidelines for residential security measures (front fences, cameras)', '2022'],
    ['/docs/acc/Two-Story-Diagram.pdf', 'Two-story diagram'], ['/docs/acc/Whats-Up-With-Sidewalks.pdf', "What's up with the sidewalks?", '2018'],
  ]},
  { title: 'Dues participation reports', items: [
    ['/docs/club/Dues-Paid-Report-2023-11-18.pdf', 'Homes paid, 2023', 'Nov 18, 2023'], ['/docs/club/Dues-Paid-Report-2023-09-29.pdf', 'Homes paid, 2023', 'Sep 29, 2023'], ['/docs/club/Dues-Paid-Report-2023-07-17.pdf', 'Homes paid, 2023', 'Jul 17, 2023'], ['/docs/club/Dues-Paid-Report-2023-05-05.pdf', 'Homes paid, 2023', 'May 5, 2023'],
    ['/docs/club/Dues-Paid-Report-2020-10-18.pdf', 'Homes paid, 2020', 'Oct 18, 2020'], ['/docs/club/Dues-Paid-Report-2020-07-10.pdf', 'Homes paid, 2020', 'Jul 10, 2020'], ['/docs/club/Dues-Paid-Report-2019-04-22.pdf', 'Homes paid, 2019', 'Apr 22, 2019'],
  ]},
  { title: 'Archive', items: [
    ['/docs/archive/70th-Anniversary-Party-2023.pdf', '70th Anniversary Party flier', '2023'], ['/docs/archive/Holiday-Decorating-Results-2023.pdf', 'Holiday decorating contest results', '2023'], ['/docs/archive/Halloween-Decorating-Results-2023.pdf', 'Halloween decorating contest results', '2023'],
    ['/docs/archive/Halloween-Decorating-Results-2022.pdf', 'Halloween decorating contest results', '2022'], ['/docs/archive/Holiday-Decorating-Results-2021.pdf', 'Holiday decorating contest results', '2021'], ['/docs/archive/Meet-Your-Neighbor-2021.pdf', 'Meet Your Neighbor', '2021'],
    ['/docs/archive/Nature-Ramble-2021.pdf', 'KVCC Nature Ramble', '2021'], ['/docs/archive/Nature-Ramble-2020.pdf', 'KVCC Nature Ramble', '2020'], ['/docs/archive/Lawn-Tips-KVCC-Presentation-2019.pdf', 'Lawn tips presentation (Southwest Fertilizer)', '2019'],
    ['/docs/archive/HCFCD-Meeting-Summary-2019-07-16.pdf', 'Harris County Flood Control meeting summary', 'Jul 2019'], ['/docs/archive/CenterPoint-Gas-Lines-2020.pdf', 'CenterPoint gas line replacement notice', '2020'], ['/docs/archive/CenterPoint-Gas-Line-Work-2020-07.pdf', 'CenterPoint gas line work to be performed', 'Jul 2020'],
    ['/docs/archive/Houston-Chronicle-1951-Wilkin-Bridge.pdf', 'Houston Chronicle article on the Hugh Wilkin Bridge', 'May 13, 1951'],
  ]},
];
---
<Base title="Documents" description="Knollwood Village Civic Club bylaws, deed restrictions, ACC forms, guidelines, meeting minutes, and dues reports.">
  <PageHead eyebrow="Library" title="Documents" lead="Bylaws, deed restrictions, building forms and guidelines, meeting minutes, and reports, all in one place." />
  <div class="container page-body">
    <nav class="jump small" aria-label="Sections">{groups.map((g) => <a href={`#${g.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{g.title}</a>)}</nav>
    {groups.map((g) => (
      <section id={g.title.toLowerCase().replace(/[^a-z]+/g, '-')}>
        <h2>{g.title}</h2>
        <ul class="doc-list">
          {g.items.map(([href, label, meta]) => <li class={href.endsWith('.docx') ? 'doc-docx' : ''}><a href={url(href)}>{label}</a>{meta && <span class="meta">{meta}</span>}</li>)}
        </ul>
      </section>
    ))}
    <p class="small muted">Looking for a newsletter? See the <a href={url('/newsletters/')}>newsletter archive</a>.</p>
  </div>
</Base>
<style>
  .jump { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
</style>
