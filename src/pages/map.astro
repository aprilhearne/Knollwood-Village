---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../lib/url';
---
<Base title="Neighborhood Map" description="Interactive map of Knollwood Village: every lot, deed-restriction sections, parks, the bayou trail, and entrance signs. Search your address.">
  <PageHead eyebrow="Explore" title="Neighborhood map" lead="Every lot in Knollwood Village and Braes Terrace II, colored by deed-restriction section. Search your address, click a lot for its section and deed restrictions, and switch to satellite view." />
  <div class="container page-body">
    <div class="map-wrap">
      <div class="map-tools"><input id="addr-search" type="search" placeholder="Search an address, e.g. 3018 Linkwood" aria-label="Search address" autocomplete="off" /><div id="addr-results" class="results" hidden></div></div>
      <div id="map" class="map" data-mode="sections" data-pois="true" data-base={import.meta.env.BASE_URL}></div>
    </div>
    <div class="grid-3">
      <div class="card"><h3>Dues participation</h3><p class="small">See which homes have contributed this year and look up your own address.</p><a class="btn btn-primary btn-sm" href={url('/dues/map/')}>Open the dues map</a></div>
      <div class="card"><h3>Deed restrictions</h3><p class="small">Each section has its own recorded restrictions. Read yours before you build.</p><a class="btn btn-outline btn-sm" href={url('/deeds/')}>Deed restrictions</a></div>
      <div class="card"><h3>Something missing?</h3><p class="small">Want a layer added, a point of interest fixed, or a block captain map? Email <a href="mailto:president@knollwoodvillage.org">president@knollwoodvillage.org</a>.</p></div>
    </div>
    <p class="small muted" style="margin-top:1.5rem">Lot outlines and section assignments come from Harris Central Appraisal District public parcel records and may lag recent replats. Map tiles by CARTO and OpenStreetMap contributors; satellite imagery by Esri.</p>
  </div>
  <script src="../scripts/map.ts"></script>
</Base>
<style is:global>
  .map-wrap { position: relative; margin: 0 0 2rem; }
  .map { height: 620px; border: 1px solid var(--line); border-radius: var(--radius); background: #eef1ee; z-index: 0; }
  @media (max-width: 700px) { .map { height: 460px; } }
  .map-tools { position: absolute; top: .75rem; left: 3.5rem; right: .75rem; z-index: 500; max-width: 380px; }
  .map-tools input { width: 100%; padding: .65rem .8rem; border: 1px solid #b9b4a6; border-radius: var(--radius); font: inherit; box-shadow: var(--shadow); }
  .results { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); max-height: 220px; overflow: auto; margin-top: .25rem; }
  .results button { display: block; width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--line); padding: .5rem .8rem; font: inherit; cursor: pointer; }
  .results button:hover { background: var(--gold-soft); }
  .leaflet-popup-content { font-family: var(--font-sans); font-size: .95rem; line-height: 1.45; }
  .leaflet-popup-content h4 { margin: 0 0 .25rem; font-family: var(--font-serif); font-size: 1.05rem; }
  .map-legend { background: #fff; padding: .6rem .8rem; border-radius: var(--radius); box-shadow: var(--shadow); font-size: .8rem; line-height: 1.5; max-width: 200px; }
  .map-legend h5 { margin: 0 0 .3rem; font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .map-legend .sw { display: inline-block; width: 12px; height: 12px; border-radius: 2px; margin-right: .4rem; vertical-align: -1px; border: 1px solid rgba(0,0,0,.25); }
  .poi-icon span { display: grid; place-items: center; width: 28px; height: 28px; background: #fff; border-radius: 50%; border: 2px solid var(--navy); font-size: 15px; box-shadow: var(--shadow); }
</style>
