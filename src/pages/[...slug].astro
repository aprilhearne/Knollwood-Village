---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <PageHead title={page.data.title} lead={page.data.description} />
  <div class="container page-body"><article class="prose"><Content /></article></div>
</Base>
