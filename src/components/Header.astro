---
import { url } from '../lib/url';
import site from '../data/site.json';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span>Smith Protective dispatch <a href={`tel:${site.patrol.dispatchTel}`}>{site.patrol.dispatch}</a> · Emergency 911</span>
      <a class="topbar-link" href={url('/contact/#email')}>Neighborhood emails</a>
    </div>
  </div>
  <div class="container header-inner">
    <a class="brand" href={url('/')} aria-label="Knollwood Village Civic Club home">
      <img src={url('/images/oak-green.png')} alt="" width="52" height="52" />
      <span class="brand-text"><span class="brand-name">Knollwood Village</span><span class="brand-sub">Civic Club · Houston · Since 1954</span></span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li class={item.children ? 'has-children' : ''}>
            <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => <li><a href={url(c.href)}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="brick-band" aria-hidden="true"></div>
</header>
<script>
  const btn = document.querySelector('.nav-toggle');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.querySelectorAll('.has-children > a').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (window.matchMedia('(max-width: 1080px)').matches) {
        const li = a.parentElement;
        if (li && !li.classList.contains('expanded')) { e.preventDefault(); li.classList.add('expanded'); }
      }
    });
  });
</script>
<style>
  .site-header { background: var(--white); position: relative; z-index: 20; }
  .topbar { background: var(--brown); color: #e9dfd0; font-size: .85rem; border-bottom: 4px solid var(--orange); }
  .topbar a { color: #fff; font-weight: 700; }
  .topbar-inner { display: flex; justify-content: space-between; gap: 1rem; padding-top: .45rem; padding-bottom: .45rem; flex-wrap: wrap; }
  .topbar-link { color: var(--gold) !important; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-top: 1rem; padding-bottom: 1rem; }
  .brand { display: flex; align-items: center; gap: .8rem; text-decoration: none; color: var(--brown); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-name { font-family: var(--font-serif); font-variation-settings: "SOFT" 100, "WONK" 1; font-weight: 700; font-size: 1.5rem; white-space: nowrap; color: var(--green); }
  .brand-sub { white-space: nowrap; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-top: .25rem; }
  .nav > ul { list-style: none; margin: 0; padding: 0; display: flex; gap: .1rem; align-items: center; }
  .nav ul.sub { list-style: none; margin: 0; padding: .4rem; }
  .nav a { display: block; white-space: nowrap; padding: .5rem .6rem; text-decoration: none; color: var(--ink); font-weight: 600; font-size: .92rem; border-radius: 6px; }
  .nav a:hover, .nav a[aria-current="page"] { background: var(--green-soft); color: var(--green); }
  .has-children { position: relative; }
  .has-children > a::after { content: " ▾"; font-size: .75em; color: var(--muted); }
  .sub { display: none; position: absolute; top: 100%; left: 0; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); min-width: 240px; flex-direction: column; align-items: stretch; }
  .has-children:hover .sub, .has-children:focus-within .sub { display: flex; }
  .sub a { font-weight: 500; border-radius: 6px; }
  .nav-toggle { display: none; font: inherit; font-weight: 700; background: none; border: 2px solid var(--brown); color: var(--brown); border-radius: 6px; padding: .45rem 1rem; cursor: pointer; }
  @media (max-width: 1080px) {
    .header-inner { flex-wrap: wrap; gap: .75rem; }
    .nav-toggle { display: block; }
    .nav { display: none; width: 100%; }
    .nav.open { display: block; }
    .nav > ul { flex-direction: column; align-items: stretch; gap: 0; }
    .nav a { padding: .8rem .5rem; border-bottom: 1px solid var(--line); border-radius: 0; }
    .sub { position: static; display: none; border: 0; box-shadow: none; padding: 0 0 0 1rem; }
    .has-children.expanded .sub { display: flex; }
    .has-children:hover .sub { display: none; }
    .has-children.expanded:hover .sub { display: flex; }
  }
</style>
