---
import Base from '../layouts/Base.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { url } from '../lib/url';
import site from '../data/site.json';
import o from '../data/officers.json';
import nl from '../data/newsletters.json';
const latest = nl[0];
---
<Base title="Board, Volunteers, and Contact" description="Meet the volunteer board of the Knollwood Village Civic Club, find the right email for your question, and learn how to get involved.">
  <div class="page-head"><div class="container">
        <h1>Board, Volunteers, and Contact</h1>
    <p class="lead">Everything the Civic Club does is done by volunteers who live here. This page covers who they are, how to reach them, and how to get involved.</p>
  </div></div>

  <div class="container page-body">
    <section class="two-col">
      <div class="prose">
        <h2 style="margin-top:0">What the Board Does</h2>
        <p>The Civic Club is a Texas nonprofit run by an elected board of resident volunteers. There is no management company and no paid staff. The board meets through the year and holds a resident meeting at least once a year. The board:</p>
        <ul>
          <li>Manages the Smith Protective patrol agreement and coordinates with the three neighboring civic clubs that share it</li>
          <li>Reviews building plans through the Architectural Control Committee and keeps the deed restrictions enforceable</li>
          <li>Keeps the esplanades mowed and planted and the entrance signs in good repair</li>
          <li>Collects dues and keeps the books</li>
          <li>Publishes the <em>Knollwood Village Voice</em> four times a year and sends email alerts</li>
          <li>Throws National Night Out, the decorating contests, and the spring festival</li>
          <li>Represents the neighborhood with city and county officials</li>
        </ul>
        <h2>Getting Involved</h2>
        <p>Most roles take a few hours a month. No experience with civic clubs or nonprofits is needed, and renters are as welcome as owners. Where help is needed right now:</p>
        <ul>
          <li><strong>Vice President.</strong> The seat is open.</li>
          <li><strong>Any committee.</strong> Architectural control, security, welcome, communications, social, and beautification all take new members.</li>
        </ul>
        <p>Email <a href={`mailto:${site.emails.president}`}>{site.emails.president}</a> and say what you'd like to do.</p>
      </div>
      <aside class="aside">
        <div class="card planter" style="padding:0;overflow:hidden">
          <a href={url(latest.file)}><img src={url('/images/newsletter-latest-cover.jpg')} alt={`Cover of the latest Knollwood Village Voice newsletter`} style="display:block" /></a>
          <div style="padding:1rem 1.25rem">
            <div class="eyebrow">The Knollwood Village Voice</div>
            <p class="small" style="margin:0">Written and mailed by volunteers four times a year. <a href={url(latest.file)}>Latest issue</a> · <a href={url('/news/#newsletters')}>Archive</a></p>
          </div>
        </div>
        <div class="card">
          <h3>Mailing Address</h3>
          <p class="small">{site.mailingAddress.map((l) => <span>{l}<br /></span>)}</p>
          <p class="small"><a href={url('/docs/club/KVCC-Bylaws-2004.pdf')}>Civic Club bylaws (PDF)</a></p>
        </div>
      </aside>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <section>
      <h2 style="margin-top:0">{o.year} Board</h2>
      <div class="grid-2 officers">
        {o.officers.map((x) => (
          <div class="card">
            <div class="eyebrow">{x.role}</div>
            <div class="name">{x.name}</div>
            {x.note && <p class="small muted" style="margin:.35rem 0 0">{x.note}</p>}
            {x.email && <p class="small" style="margin:.35rem 0 0"><a href={`mailto:${x.email}`}>{x.email}</a></p>}
          </div>
        ))}
      </div>
      <h3>Board of Directors</h3>
      <p>{o.board.join(' · ')}</p>

      <h2>Committees</h2>
      <div class="grid-2">
        {o.committees.map((c) => (
          <div class="committee">
            <h3>{c.name}</h3>
            <p class="small muted" style="margin:0 0 .35rem">{c.blurb}</p>
            <p style="margin:0">{c.chair && <span><strong>{c.chair}</strong>, Chair{c.members.length ? ' · ' : ''}</span>}{c.members.join(', ')}</p>
            {c.email && <p style="margin:.25rem 0 0"><a href={`mailto:${c.email}`}>{c.email}</a></p>}
          </div>
        ))}
      </div>
    </section>

    <div class="section-divider" aria-hidden="true"></div>

    <section class="two-col">
      <div>
        <h2 style="margin-top:0">Who to Email</h2>
        <div class="table-wrap"><table>
          <tr><td>Anything about the club, volunteering, or this website</td><td><a href={`mailto:${site.emails.president}`}>{site.emails.president}</a></td></tr>
          <tr><td>Dues and payments</td><td><a href={`mailto:${site.emails.treasurer}`}>{site.emails.treasurer}</a></td></tr>
          <tr><td>Building plans, fences, sheds, deed restrictions</td><td><a href={`mailto:${site.emails.build}`}>{site.emails.build}</a></td></tr>
          <tr><td>Security and the Smith patrol</td><td><a href={`mailto:${site.emails.security}`}>{site.emails.security}</a></td></tr>
          <tr><td>New to the neighborhood</td><td><a href={`mailto:${site.emails.welcome}`}>{site.emails.welcome}</a></td></tr>
          <tr><td>Events and the social committee</td><td><a href={`mailto:${site.emails.social}`}>{site.emails.social}</a></td></tr>
          <tr><td>Advertising in the Voice</td><td><a href={`mailto:${site.emails.advertise}`}>{site.emails.advertise}</a></td></tr>
          <tr><td>Title companies and real estate agents</td><td><a href={url('/realtors/')}>Read this first</a></td></tr>
        </table></div>

        <h2>Useful Phone Numbers</h2>
        <div class="table-wrap"><table>
          {site.phones.map((ph) => <tr><td>{ph.label}</td><td><a href={`tel:${ph.tel}`}>{ph.value}</a>{ph.email && <span> · <a href={`mailto:${ph.email}`}>{ph.email}</a></span>}</td></tr>)}
        </table></div>
        <p class="small">City of Houston services (nuisance violations, water and sewer repairs, heavy trash, streetlights, potholes): call <strong>311</strong> or use <a href="https://www.houstontx.gov/311/">houstontx.gov/311</a>.</p>
      </div>
      <aside class="aside">
        <div class="card" id="email">
          <h3>Neighborhood Emails</h3>
          <EmailSignup />
        </div>
      </aside>
    </section>
  </div>
</Base>
<style>
  .officers .card + .card { margin-top: 0; }
  .name { font-family: var(--font-serif); font-variation-settings: "SOFT" 100; font-size: 1.3rem; color: var(--brown); }
  .committee { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .committee h3 { margin: 0 0 .25rem; font-size: 1.1rem; }
</style>
