---
import Base from '../layouts/Base.astro';
import EmailSignup from '../components/EmailSignup.astro';
import NewsCard from '../components/NewsCard.astro';
import { url } from '../lib/url';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
const now = new Date();
const all = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const upcoming = all.filter((p) => p.data.eventDate && p.data.eventDate.valueOf() > now.valueOf() - 86400000).sort((a, b) => a.data.eventDate!.valueOf() - b.data.eventDate!.valueOf());
const recent = all.filter((p) => !upcoming.includes(p)).slice(0, 4);
const featured = upcoming[0];
const t = (d: Date) => d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' });
const day = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/Chicago' });
---
<Base title="Home" description={`${site.name}: a volunteer civic club for the ${site.homes} homes of Knollwood Village in Houston. Smith Protective patrol, deed restrictions, dues, newsletters, and news.`}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1>Knollwood Village Civic Club</h1>
        <p class="lead">Knollwood Village is {site.homes} homes inside the Loop between Kirby, Main, Stella Link, and Brays Bayou. The Civic Club is the volunteer group of neighbors that funds the Smith Protective patrol, keeps up the deed restrictions and esplanades, and puts out the newsletter.</p>
        <p>New to the neighborhood? <a href={url('/new-residents/')}>Start with the resident guide.</a><br />Smith Protective dispatch: <a href={`tel:${site.patrol.dispatchTel}`}>{site.patrol.dispatch}</a>. In an emergency, call 911 first.</p>
      </div>
      <img class="hero-photo" src={url('/images/about/knollwood-sign.jpg')} alt="Knollwood Village entrance sign, brick columns under live oaks" />
    </div>
  </section>

  <section class="container main-grid">
    <div>
      {featured && (
        <div class="event">
          <div class="event-text">
            <div class="small muted">Coming up</div>
            <h2><a href={url(`/news/${featured.id}/`)}>{featured.data.title}</a></h2>
            <p>{day(featured.data.eventDate!)}{featured.data.eventDate!.getUTCHours() ? ', ' + t(featured.data.eventDate!) : ''}{featured.data.eventEnd ? ' to ' + t(featured.data.eventEnd) : ''}<br />{featured.data.location}</p>
            {featured.data.description && <p>{featured.data.description}</p>}
          </div>
          {featured.data.image && <a href={url(`/news/${featured.id}/`)}><img src={url(featured.data.image)} alt="" /></a>}
        </div>
      )}

      <h2>News</h2>
      {upcoming.slice(1).map((p) => <NewsCard title={p.data.title} slug={p.id} date={p.data.date} eventDate={p.data.eventDate} location={p.data.location} description={p.data.description} />)}
      {recent.map((p) => <NewsCard title={p.data.title} slug={p.id} date={p.data.date} description={p.data.description} />)}
      <p style="margin-top:1rem"><a href={url('/news/')}>All news and the newsletter archive</a></p>
    </div>
    <aside class="aside">
      <div class="card">
        <h3>About the Club</h3>
        <p class="small">The Civic Club is not an HOA. Dues are voluntary, there is no management company, and the board is elected neighbors. Dues pay for the Smith patrol, deed restriction enforcement, the esplanades, the newsletter, and events like National Night Out.</p>
        <p class="small" style="margin:0">{site.duesYear} dues are ${site.duesAmount} per household. <a href={url('/dues/')}>How to pay, and who has contributed</a></p>
      </div>
      <div class="card">
        <h3>Neighborhood Emails</h3>
        <p class="small">Security notes, meeting dates, and events. A few a month at most.</p>
        <EmailSignup compact />
      </div>
    </aside>
  </section>
</Base>
<style>
  .hero { background: var(--white); border-bottom: 1px solid var(--line); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr); gap: 3rem; align-items: center; padding-top: 3rem; padding-bottom: 3rem; }
  @media (max-width: 860px) { .hero-inner { grid-template-columns: 1fr; gap: 1.5rem; } }
  .hero h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin-bottom: .75rem; }
  .hero .lead { font-size: 1.1rem; }
  .hero-photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); }
  .strip { background: var(--cream-2); color: var(--ink); border-bottom: 1px solid var(--line); }
  .strip a { color: var(--green); }
  .strip-label { font-weight: 700; color: var(--brown); margin-right: .5rem; }
  .strip .tel { color: var(--brown); font-size: 1.35rem; }
  .strip-inner { padding-top: .8rem; padding-bottom: .8rem; }
  .main-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 3rem; padding-top: 2.5rem; padding-bottom: 2rem; }
  @media (max-width: 900px) { .main-grid { grid-template-columns: 1fr; } }
  .event { display: grid; grid-template-columns: 1fr 180px; gap: 1.5rem; align-items: start; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin-bottom: 2rem; }
  @media (max-width: 600px) { .event { grid-template-columns: 1fr; } }
  .event h2 { margin: .2rem 0 .5rem; font-size: 1.5rem; }
  .event h2 a { text-decoration: none; }
  .event h2 a:hover { text-decoration: underline; }
  .event p { margin: 0 0 .5rem; }
  .event img { width: 100%; border: 1px solid var(--line); background: #fff; border-radius: 6px; }
</style>
