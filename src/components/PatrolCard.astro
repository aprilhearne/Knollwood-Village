---
import { url } from '../lib/url';
import site from '../data/site.json';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class="patrol">
  <div class="patrol-top">
    <div>
      <div class="eyebrow" style="color:var(--gold)">Neighborhood security patrol</div>
      <div class="patrol-title">Our patrol is on duty every day of the year</div>
      {!compact && <div class="patrol-since">Smith Protective Services, on patrol in Knollwood Village since August 19, 2026</div>}
    </div>
    <img src={url('/images/smith-badge.png')} alt="Smith Protective Services" width={compact ? 44 : 60} />
  </div>
  <div class="patrol-dispatch">
    <div class="eyebrow" style="color:var(--brown-2)">Patrol dispatch, save it in your phone</div>
    <a class="tel" href={`tel:${site.patrol.dispatchTel}`}>{site.patrol.dispatch}</a>
    <div class="small">For anything that seems off on your street. In an emergency, always call 911 first.</div>
    {!compact && <a class="small" style="display:inline-block;margin-top:.6rem" href={url('/security/')}>How the patrol works, and vacation watch →</a>}
  </div>
</div>
<style>
  .patrol { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--white); box-shadow: var(--shadow); }
  .patrol-top { background: var(--green); color: #fff; padding: 1.25rem 1.4rem; display: flex; gap: 1rem; align-items: center; justify-content: space-between; }
  .patrol-top img { flex: none; opacity: .95; }
  .patrol-title { font-family: var(--font-serif); font-variation-settings: "SOFT" 100; font-size: 1.35rem; line-height: 1.2; }
  .patrol-since { color: #cfdcc9; font-size: .85rem; margin-top: .5rem; }
  .patrol-dispatch { background: var(--gold-soft); padding: 1.1rem 1.4rem; text-align: center; }
  .patrol-dispatch .tel { display: block; font-size: 2rem; margin: .2rem 0; color: var(--brown); }
</style>
